include README.md
include LICENSE
include pyproject.toml
graft src
graft examples
prune tests
prune build
prune dist
prune src/*.egg-info
prune src/diddesign/__pycache__
prune src/diddesign/core/__pycache__
prune src/diddesign/estimators/__pycache__
prune src/diddesign/results/__pycache__
global-exclude *.py[cod]
